# Example environment file for self-hosted deployments.
# Ledgerline reads environment variables directly; it does not load .env itself.
# Docker Compose and most process managers will read this file for you.

# Port to listen on. With Docker, the host port is separate from this value.
PORT=3000

# SQLite database location, relative to the project root or absolute.
ACCOUNTING_DB_PATH=data/accounting.sqlite

# Only set to 1 inside a container. It allows the process to bind 0.0.0.0 so
# Docker can forward the port. Never set it for a directly exposed host process.
LEDGERLINE_CONTAINER=0

# Set to 1 only when the app is served over HTTPS. The default cookie is
# HttpOnly and SameSite=Strict without Secure, which is correct for local HTTP.
LEDGERLINE_SECURE_COOKIES=0
